{
  "provider": "generic",
  "generic_provider": {
    "name": "abuseipdb",
    "base_url": "https://api.abuseipdb.com/api/v2",
    "mode": "single",
    "method": "GET",
    "auth": {
      "header": "Key",
      "env_var": "ABUSEIPDB_API_KEY"
    },
    "allowed_hosts": ["api.abuseipdb.com"],
    "max_concurrency": 2,
    "ip": {
      "path_template": "/check?ipAddress={ip}&maxAgeInDays=90",
      "mapping": {
        "score_path": "data.abuseConfidenceScore"
      }
    }
  },
  "min_malicious_score_to_block": 50
}
